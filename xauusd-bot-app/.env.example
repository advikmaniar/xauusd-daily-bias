# Copy this to .env and fill in real values. Never commit .env to git.

# V1 routine ("Gold Bias V1", original engine): from the routine's edit
# page: Add another trigger -> API -> Generate token
ROUTINE_V1_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_XXXXXXXXXXXXXXXXXXXXXXXX/fire
ROUTINE_V1_BEARER_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# V2 routine ("Gold Bias V2", liquidity/fib confluence engine): same, from
# that routine's own trigger
ROUTINE_V2_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_XXXXXXXXXXXXXXXXXXXXXXXX/fire
ROUTINE_V2_BEARER_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From get_google_refresh_token.py's one-time output (covers Calendar +
# Sheets scopes)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=xxxxxxxx

# Optional, defaults to "primary"
GOOGLE_CALENDAR_ID=primary

# "Gold Bias Log" spreadsheet ID (from its URL) — accuracy tracker. Leave
# unset to skip logging entirely.
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
