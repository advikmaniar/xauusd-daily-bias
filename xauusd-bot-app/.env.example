# Copy this to .env and fill in real values. Never commit .env to git.

# From the routine's edit page: Add another trigger -> API -> Generate token
ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_XXXXXXXXXXXXXXXXXXXXXXXX/fire
ROUTINE_BEARER_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From get_google_refresh_token.py's one-time output
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=xxxxxxxx

# Optional, defaults to "primary"
GOOGLE_CALENDAR_ID=primary
